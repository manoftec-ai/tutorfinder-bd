---
import Base from "../../layouts/Base.astro";
import ReviewCard from "../../components/ReviewCard.astro";
import Stars from "../../components/Stars.astro";
import { supabaseFromCookies } from "../../lib/supabase";
import { hasSupabase } from "../../lib/env";
import { getApprovedReviews, getTutorBySlug, requireProfile, type Area, type Level, type ReviewRow, type Subject, type TutorWithRelations } from "../../lib/db";
import { expLabel, formatFee, modeLabels, photoUrl } from "../../lib/directory";

const { slug } = Astro.params;
const sb = supabaseFromCookies(Astro.cookies);
const profile = await requireProfile(sb);

let tutor: TutorWithRelations | null = null;
let reviews: ReviewRow[] = [];
let areas: Area[] = [];
let subjects: Subject[] = [];
let levels: Level[] = [];

if (hasSupabase && slug) {
  const [t, a, s, l] = await Promise.all([
    getTutorBySlug(sb, String(slug)),
    sb.from("areas").select("id, slug, name").order("name"),
    sb.from("subjects").select("id, slug, name").order("name"),
    sb.from("levels").select("id, code, label").order("id"),
  ]);
  tutor = t;
  areas = (a.data as Area[]) ?? [];
  subjects = (s.data as Subject[]) ?? [];
  levels = (l.data as Level[]) ?? [];
}

if (tutor) {
  reviews = await getApprovedReviews(sb, tutor.id);
}

if (!tutor) {
  Astro.response.status = 404;
}

const isSelf = tutor !== null && profile !== null && profile.id === tutor.id;

const photo = tutor ? photoUrl(tutor.photo_url) : "";
const modes = tutor ? modeLabels(tutor.modes) : [];
const jsonLd = tutor
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: tutor.name,
      description: tutor.headline ? tutor.headline : undefined,
      jobTitle: "Private Tutor",
      address: { "@type": "Place", addressLocality: "Dhaka, Bangladesh" },
      aggregateRating: tutor.review_count
        ? { "@type": "AggregateRating", ratingValue: tutor.ratings_avg, reviewCount: tutor.review_count }
        : undefined,
    })
  : "";
---

<Base
  title={tutor ? `${tutor.name} — Home & online tutor | TutorFinder BD` : "Tutor not found | TutorFinder BD"}
  description={tutor?.headline ?? "Tutor profile"}
  profile={profile}
  jsonLd={tutor ? jsonLd : ""}
>
  {!tutor ? (
    <div class="container-page py-20 text-center">
      <h1 class="text-2xl font-bold text-slate-900">Tutor not found</h1>
      <p class="mt-3 text-slate-500">
        This profile may have been removed or is awaiting approval.{" "}
        <a href="/search/" class="text-emerald-700 hover:underline">Back to search</a>
      </p>
    </div>
  ) : (
    <section class="container-page py-10">
      <div class="grid gap-8 lg:grid-cols-3">
        <!-- Profile card -->
        <div class="lg:col-span-1">
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            {photo ? (
              <img src={photo} alt={tutor.name} class="h-24 w-24 rounded-2xl object-cover" />
            ) : (
              <span class="flex h-24 w-24 items-center justify-center rounded-2xl bg-emerald-100 text-3xl font-bold text-emerald-800">
                {(tutor.name || "?").slice(0, 1).toUpperCase()}
              </span>
            )}
            <div class="mt-4">
              <div class="flex items-center gap-2">
                <h1 class="text-xl font-bold text-slate-900">{tutor.name}</h1>
                {tutor.verification_status === "verified" && (
                  <span title="Verified tutor" class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-800">Verified ✔</span>
                )}
              </div>
              {tutor.headline && <p class="mt-1 text-sm text-slate-600">{tutor.headline}</p>}
              {tutor.institution && <p class="mt-1 text-sm text-slate-400">{tutor.institution}</p>}
            </div>

            <dl class="mt-5 space-y-3 border-t border-slate-100 pt-4 text-sm">
              {tutor.qualification && (
                <div><dt class="text-xs uppercase tracking-wide text-slate-400">Qualification</dt><dd class="mt-0.5 text-slate-700">{tutor.qualification}</dd></div>
              )}
              <div><dt class="text-xs uppercase tracking-wide text-slate-400">Experience</dt><dd class="mt-0.5 text-slate-700">{expLabel(tutor.experience_months)}</dd></div>
              <div><dt class="text-xs uppercase tracking-wide text-slate-400">Fee per month</dt><dd class="mt-0.5 font-semibold text-emerald-800">{formatFee(tutor.fee_min, tutor.fee_max, tutor.currency)}</dd></div>
              <div><dt class="text-xs uppercase tracking-wide text-slate-400">Modes</dt><dd class="mt-0.5 text-slate-700">{modes.length ? modes.join(", ") : "—"}</dd></div>
              <div><dt class="text-xs uppercase tracking-wide text-slate-400">Areas</dt><dd class="mt-0.5 text-slate-700">{tutor.areas.length ? tutor.areas.map((a) => a.name).join(", ") : "—"}</dd></div>
              <div><dt class="text-xs uppercase tracking-wide text-slate-400">Subjects</dt><dd class="mt-0.5 text-slate-700">{tutor.subjects.length ? tutor.subjects.map((s) => s.name).join(", ") : "—"}</dd></div>
              <div><dt class="text-xs uppercase tracking-wide text-slate-400">Classes / levels</dt><dd class="mt-0.5 text-slate-700">{tutor.levels.length ? tutor.levels.map((l) => l.label).join(", ") : "—"}</dd></div>
              <div class="flex items-center justify-between"><dt class="text-xs uppercase tracking-wide text-slate-400">Rating</dt><dd class="flex items-center gap-1 text-slate-700">{tutor.review_count > 0 ? <><Stars rating={tutor.ratings_avg} size="sm" /><span>{tutor.ratings_avg.toFixed(1)} ({tutor.review_count})</span></> : <span>New — no reviews yet</span>}</dd></div>
            </dl>
          </div>
        </div>

        <!-- Bio + contact + reviews -->
        <div class="lg:col-span-2">
          {tutor.bio && (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h2 class="font-semibold text-slate-900">About this tutor</h2>
              <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-600">{tutor.bio}</p>
            </div>
          )}

          <!-- Contact -->
          <div class="mt-5 rounded-2xl border border-emerald-200 bg-emerald-50 p-6">
            {isSelf ? (
              <p class="text-sm text-emerald-900">This is your public profile as it appears to guardians.</p>
            ) : !profile ? (
              <div class="text-center">
                <h2 class="font-semibold text-slate-900">Want this tutor?</h2>
                <p class="mt-1 text-sm text-slate-600">Create a free guardian account to send a contact request.</p>
                <a
                  href={`/login/?next=${encodeURIComponent(`/tutor/${tutor.slug}/`)}`}
                  class="mt-4 inline-block rounded-lg bg-emerald-700 px-6 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800"
                >
                  Login / sign up free
                </a>
              </div>
            ) : profile.role === "guardian" ? (
              <div>
                <h2 class="font-semibold text-slate-900">Request this tutor's contact</h2>
                <p class="mt-1 text-sm text-slate-600">Free and non-binding. The tutor will see your request and respond.</p>
                <form method="post" action="/api/guardian/request/" class="mt-4 grid gap-3 sm:grid-cols-2">
                  <input type="hidden" name="tutorSlug" value={tutor.slug} />
                  <select name="subject" required class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
                    <option value="">Subject needed *</option>
                    {subjects.map((s) => <option value={s.slug}>{s.name}</option>)}
                  </select>
                  <select name="level" required class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
                    <option value="">Class / level needed *</option>
                    {levels.map((l) => <option value={l.code}>{l.label}</option>)}
                  </select>
                  <select name="area" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm">
                    <option value="">Area (optional)</option>
                    {areas.map((a) => <option value={a.slug}>{a.name}</option>)}
                  </select>
                  <input type="text" name="whatsapp" placeholder="Your phone / WhatsApp (optional)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm" />
                  <textarea name="message" rows={3} placeholder="What does your child need help with? (optional)" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm sm:col-span-2"></textarea>
                  <button type="submit" class="rounded-lg bg-emerald-700 px-6 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800 sm:col-span-2">
                    Send contact request
                  </button>
                </form>
              </div>
            ) : (
              <p class="text-sm text-emerald-900">Guardians request tutoring via this form.</p>
            )}
          </div>

          <!-- Reviews -->
          <div class="mt-8">
            <h2 class="flex items-center justify-between font-semibold text-slate-900">
              Reviews
              {tutor.review_count > 0 && (
                <span class="flex items-center gap-1 text-sm font-normal text-slate-500">
                  <Stars rating={tutor.ratings_avg} /> {tutor.ratings_avg.toFixed(1)} · {tutor.review_count} verified
                </span>
              )}
            </h2>
            <p class="mt-1 text-xs text-slate-400">Only guardians who completed a real lesson can review. Every review is moderated.</p>
            <div class="mt-4 space-y-4">
              {reviews.length > 0 ? (
                reviews.map((r) => <ReviewCard review={r} />)
              ) : (
                <div class="rounded-2xl border border-dashed border-slate-300 p-8 text-center text-sm text-slate-500">
                  No reviews yet — the first honest lesson will change that.
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}
</Base>