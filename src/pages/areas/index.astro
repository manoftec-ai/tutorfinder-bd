---
import Base from "../../layouts/Base.astro";
import { supabaseFromCookies } from "../../lib/supabase";
import { hasSupabase } from "../../lib/env";
import { requireProfile, type Area } from "../../lib/db";

const sb = supabaseFromCookies(Astro.cookies);
const profile = await requireProfile(sb);

let areas: Area[] = [];
const counts: Record<number, number> = {};

if (hasSupabase) {
  const [a, l] = await Promise.all([
    sb.from("areas").select("id, slug, name, bengali_name, thana").order("name"),
    sb.from("tutor_areas").select("area_id"),
  ]);
  areas = (a.data as Area[]) ?? [];
  (l.data ?? []).forEach((r) => {
    counts[r.area_id] = (counts[r.area_id] ?? 0) + 1;
  });
}
---

<Base
  title="Browse tutors by area in Dhaka | TutorFinder BD"
  description="Browse home and online tutors by Dhaka area — Dhanmondi, Uttara, Bashundhara, Mirpur, Mohammadpur and more."
  profile={profile}
>
  <section class="container-page py-10">
    <h1 class="text-2xl font-bold text-slate-900 sm:text-3xl">Tutors by area</h1>
    <p class="mt-2 max-w-2xl text-sm text-slate-500">
      Dhaka-first directory. Pick your area to see tutors teaching there — home,
      online or group. New areas across the country roll out next.
    </p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {areas.map((a) => (
        <a
          href={`/areas/${a.slug}/`}
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md"
        >
          <div class="flex items-center justify-between">
            <div>
              <h2 class="font-semibold text-slate-900">{a.name}</h2>
              <p class="text-xs text-slate-400">{a.thana || "Dhaka"} {a.bengali_name && `· ${a.bengali_name}`}</p>
            </div>
            <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">
              {(counts[a.id] ?? 0)} tutor{(counts[a.id] ?? 0) === 1 ? "" : "s"}
            </span>
          </div>
        </a>
      ))}
    </div>
    {areas.length === 0 && (
      <div class="mt-10 rounded-2xl border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500">
        Area listing loading soon. <a href="/search/" class="text-emerald-700 hover:underline">Try search</a>.
      </div>
    )}
  </section>
</Base>