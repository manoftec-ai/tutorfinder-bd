---
import Base from "../layouts/Base.astro";
import { adminClient, supabaseFromCookies } from "../lib/supabase";
import { SUPABASE_SERVICE_ROLE_KEY, hasSupabase } from "../lib/env";
import { requireProfile } from "../lib/db";
import { formatDate } from "../lib/directory";

const profile = await requireProfile(supabaseFromCookies(Astro.cookies), "admin");
if (!profile) return Astro.redirect("/login/");

let pendingTutors: any[] = [];
let pendingReviews: any[] = [];
let names: Record<string, string> = {};

if (hasSupabase && SUPABASE_SERVICE_ROLE_KEY) {
  const adm = adminClient();
  const [t, r, n] = await Promise.all([
    adm.from("tutor_profiles").select("*").eq("status", "pending").order("created_at", { ascending: true }),
    adm.from("reviews").select("*").eq("moderation_status", "pending").order("created_at", { ascending: true }),
    adm.from("profiles").select("id, name, role"),
  ]);
  pendingTutors = (t.data as any[]) ?? [];
  pendingReviews = (r.data as any[]) ?? [];
  for (const p of n.data ?? []) names[p.id] = p.name ?? "";
}
const input = "rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800";
---

<Base
  title="Admin dashboard — TutorFinder BD"
  description="Moderate tutors and reviews."
  profile={profile}
>
  <section class="container-page py-10">
    <h1 class="text-2xl font-bold text-slate-900">Admin moderation</h1>

    <h2 class="mt-8 text-lg font-semibold text-slate-900">Tutors awaiting approval ({pendingTutors.length})</h2>
    {pendingTutors.length === 0 && <p class="mt-2 text-sm text-slate-400">All caught up.</p>}
    <div class="mt-3 space-y-3">
      {pendingTutors.map((t) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="font-semibold text-slate-900">{names[t.id] ?? t.id.slice(0, 8)}</span>
              <span class="ml-2 text-xs text-slate-400">signup {formatDate(t.created_at)}</span>
            </div>
            <form method="post" action="/api/admin/decide-tutor/" class="flex gap-2">
              <input type="hidden" name="tutorId" value={t.id} />
              <button name="action" value="approve" class="rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800">Approve</button>
              <button name="action" value="suspend" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50">Reject</button>
            </form>
          </div>
          <p class="mt-2 text-sm text-slate-600">{t.headline}, {t.institution}</p>
          <p class="mt-1 text-xs text-slate-400">Fee ৳{t.fee_min}–৳{t.fee_max} · {t.experience_months}mo exp</p>
        </div>
      ))}
    </div>

    <h2 class="mt-10 text-lg font-semibold text-slate-900">Reviews awaiting moderation ({pendingReviews.length})</h2>
    {pendingReviews.length === 0 && <p class="mt-2 text-sm text-slate-400">All caught up.</p>}
    <div class="mt-3 space-y-3">
      {pendingReviews.map((r) => (
        <div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <span class="font-semibold text-slate-900">★ {r.rating_overall}/5</span>
              <span class="ml-2 text-sm text-slate-500">for {names[r.tutor_id] ?? r.tutor_id.slice(0, 8)}</span>
              <span class="ml-2 text-xs text-slate-400">by {names[r.guardian_id]?.split(" ")[0] ?? "guardian"} on {formatDate(r.created_at)}</span>
            </div>
            <form method="post" action="/api/admin/moderate-review/" class="flex gap-2">
              <input type="hidden" name="reviewId" value={r.id} />
              <button name="action" value="approve" class="rounded-lg bg-emerald-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-emerald-800">Approve</button>
              <button name="action" value="remove" class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50">Remove</button>
            </form>
          </div>
          {r.comment && <p class="mt-2 text-sm text-slate-700">"{r.comment}"</p>}
        </div>
      ))}
    </div>
  </section>
</Base>