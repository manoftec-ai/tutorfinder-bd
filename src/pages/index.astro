---
import Base from "../layouts/Base.astro";
import SearchForm from "../components/SearchForm.astro";
import TutorCard from "../components/TutorCard.astro";
import { supabaseFromCookies } from "../lib/supabase";
import { hasSupabase } from "../lib/env";
import { listTutors, requireProfile, type Area, type Level, type Subject, type TutorWithRelations } from "../lib/db";

const sb = supabaseFromCookies(Astro.cookies);
const profile = await requireProfile(sb);

let areas: Area[] = [];
let subjects: Subject[] = [];
let levels: Level[] = [];
let featured: TutorWithRelations[] = [];
let tutorCount = 0;
let verifiedCount = 0;
let reviewCount = 0;

if (hasSupabase) {
  const [a, s, l, feat, tc, vc, rc] = await Promise.all([
    sb.from("areas").select("id, slug, name").order("name"),
    sb.from("subjects").select("id, slug, name").order("name"),
    sb.from("levels").select("id, code, label").order("id"),
    listTutors(sb, { perPage: 4 }),
    sb.from("tutor_profiles").select("id", { count: "exact", head: true }).eq("status", "active"),
    sb.from("tutor_profiles").select("id", { count: "exact", head: true }).eq("verification_status", "verified"),
    sb.from("reviews").select("id", { count: "exact", head: true }).eq("moderation_status", "approved"),
  ]);
  areas = (a.data as Area[]) ?? [];
  subjects = (s.data as Subject[]) ?? [];
  levels = (l.data as Level[]) ?? [];
  featured = feat.tutors;
  tutorCount = tc.count ?? 0;
  verifiedCount = vc.count ?? 0;
  reviewCount = rc.count ?? 0;
}

const stats = [
  { value: tutorCount ? tutorCount.toLocaleString("en-BD") : "0", label: "Free tutor profiles" },
  { value: verifiedCount ? verifiedCount.toLocaleString("en-BD") : "0", label: "Verified tutors" },
  { value: reviewCount ? reviewCount.toLocaleString("en-BD") : "0", label: "Verified reviews" },
  { value: "৳0", label: "Placement fee, forever" },
];
---

<Base
  title="TutorFinder BD — Find verified home & online tutors in Dhaka, free"
  description="Free tutor directory for Bangladesh. Tutors list for free, guardians search by area, subject and class, and read honest reviews from real lessons. No placement commission — ever."
  profile={profile}
>
  <!-- HERO -->
  <section class="bg-gradient-to-b from-emerald-50 to-white">
    <div class="container-page py-14 lg:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-5xl">
          Find the perfect tutor — <span class="text-emerald-700">free, no commission</span>
        </h1>
        <p class="mt-4 text-base text-slate-600 sm:text-lg">
          Tutors around Dhaka list themselves for free. Guardians search by area,
          subject and class, compare real reviews from real lessons, and hire directly.
          No "tuition media" fees, no middlemen.
        </p>
      </div>
      <div class="mx-auto mt-8 max-w-4xl rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm sm:p-6">
        <SearchForm areas={areas} subjects={subjects} levels={levels} compact />
      </div>
      <div class="mx-auto mt-10 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
        {stats.map((s) => (
          <div class="rounded-xl bg-white/70 p-4 text-center">
            <div class="text-xl font-bold text-emerald-800 sm:text-2xl">{s.value}</div>
            <div class="mt-1 text-xs text-slate-500">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="container-page py-14">
    <h2 class="text-center text-2xl font-bold text-slate-900">How it works</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="text-3xl">👩‍🏫</div>
        <h3 class="mt-3 font-semibold text-slate-900">Tutors list for free</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">
          Create a profile with your subjects, areas, classes and fees. Get verified
          and eligible for the "Verified tutor" badge.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="text-3xl">🔍</div>
        <h3 class="mt-3 font-semibold text-slate-900">Guardians find the match</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">
          Filter by area, subject and class, compare profiles and reviews, then send a
          free contact request. No payment to us, ever.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6">
        <div class="text-3xl">⭐</div>
        <h3 class="mt-3 font-semibold text-slate-900">Real reviews only</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">
          After a real lesson, guardians rate the tutor. Reviews are tied to real
          engagements and moderated — so ratings stay honest.
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURED TUTORS -->
  {featured.length > 0 && (
    <section class="container-page py-10">
      <h2 class="text-2xl font-bold text-slate-900">Featured tutors</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((t) => <TutorCard tutor={t} />)}
      </div>
    </section>
  )}

  <!-- TRUST / NO-FEE -->
  <section class="bg-emerald-800 py-12 text-white">
    <div class="container-page mx-auto max-w-3xl text-center">
      <h2 class="text-2xl font-bold">Why we exist</h2>
      <p class="mt-3 text-sm leading-relaxed text-emerald-100 sm:text-base">
        Many Bangladeshi tutors pay 40–70% of their first month's fee to "tuition media"
        middlemen — and guardians often get a random tutor, not the right one. We built
        TutorFinder BD to be the opposite: free for both sides, transparent profiles,
        and honest, verified reviews.
      </p>
      <a href="/join/" class="mt-6 inline-block rounded-lg bg-white px-6 py-2.5 text-sm font-semibold text-emerald-800 hover:bg-emerald-50">
        List for free as a tutor
      </a>
    </div>
  </section>
</Base>