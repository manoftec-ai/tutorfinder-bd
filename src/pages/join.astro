---
import Base from "../layouts/Base.astro";
import { supabaseFromCookies } from "../lib/supabase";
import { requireProfile } from "../lib/db";

const profile = await requireProfile(supabaseFromCookies(Astro.cookies));
const error = Astro.url.searchParams.get("error");
const checkEmail = Astro.url.searchParams.get("check-email");
const input =
  "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:border-emerald-500 focus:outline-none w-full";
---

<Base
  title="Join TutorFinder BD free — tutors & guardians"
  description="Create a free account on TutorFinder BD as a tutor or guardian. No fees, no commission."
  profile={profile}
>
  <section class="container-page py-12">
    <div class="mx-auto max-w-md">
      {profile ? (
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-8 text-center">
          <p class="text-sm text-emerald-900">You're already signed in.</p>
          <a
            href={profile.role === "tutor" ? "/tutor/dashboard/" : profile.role === "admin" ? "/admin/dashboard/" : "/guardian/dashboard/"}
            class="mt-3 inline-block rounded-lg bg-emerald-700 px-5 py-2 text-sm font-semibold text-white"
          >
            Go to dashboard
          </a>
        </div>
      ) : (
        <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
          <h1 class="text-2xl font-bold text-slate-900">Create your free account</h1>
          <p class="mt-1 text-sm text-slate-500">Free forever for both tutors and guardians. No commission, no fees.</p>

          {error && (
            <p class="mt-4 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-600">Error: {error}</p>
          )}
          {checkEmail && (
            <p class="mt-4 rounded-lg bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
              Account created! Check your email to confirm, then login.
            </p>
          )}

          <form method="post" action="/api/auth/signup/" class="mt-6 space-y-4">
            <div>
              <label class="mb-1 block text-sm font-medium text-slate-700">I am a…</label>
              <div class="grid grid-cols-2 gap-2">
                {[
                  { value: "guardian", label: "Guardian", desc: "I want a tutor" },
                  { value: "tutor", label: "Tutor", desc: "I give lessons" },
                ].map((r) => (
                  <label class="cursor-pointer rounded-xl border border-slate-200 p-3 text-center has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50">
                    <input type="radio" name="role" value={r.value} class="sr-only" checked={r.value === "guardian"} />
                    <span class="block text-sm font-semibold text-slate-800">{r.label}</span>
                    <span class="block text-xs text-slate-400">{r.desc}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium text-slate-700" for="name">Full name</label>
              <input id="name" name="name" type="text" required class={input} placeholder="e.g. Ayesha Rahman" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium text-slate-700" for="email">Email</label>
              <input id="email" name="email" type="email" required class={input} placeholder="you@example.com" />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium text-slate-700" for="password">Password (min 6 characters)</label>
              <input id="password" name="password" type="password" required minlength={6} class={input} />
            </div>
            <div>
              <label class="mb-1 block text-sm font-medium text-slate-700" for="phone">Phone / WhatsApp (optional)</label>
              <input id="phone" name="phone" type="text" class={input} placeholder="+8801XXXXXXXXX" />
            </div>
            <button type="submit" class="w-full rounded-lg bg-emerald-700 py-2.5 text-sm font-semibold text-white hover:bg-emerald-800">
              Create account
            </button>
          </form>
          <p class="mt-5 text-center text-sm text-slate-500">
            Already have an account? <a href="/login/" class="text-emerald-700 hover:underline">Login</a>
          </p>
        </div>
      )}
    </div>
  </section>
</Base>