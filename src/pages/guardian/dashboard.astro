---
import Base from "../../layouts/Base.astro";
import { supabaseFromCookies, T } from "../../lib/supabase";
import { hasSupabase } from "../../lib/env";
import { getReviewsForGuardian, getTutorsByIds, requireProfile, type EngagementRow, type ReviewRow } from "../../lib/db";
import { formatDate } from "../../lib/directory";

const sb = supabaseFromCookies(Astro.cookies);
const profile = await requireProfile(sb, "guardian");
if (!profile) {
  return Astro.redirect("/login/");
}

let engagements: EngagementRow[] = [];
let reviewByEngagement: Record<number, ReviewRow> = {};
if (hasSupabase) {
  const [e, rev] = await Promise.all([
    sb.from(T.engagements).select("*").eq("guardian_id", profile.id).order("created_at", { ascending: false }),
    getReviewsForGuardian(sb, profile.id),
  ]);
  engagements = (e.data as EngagementRow[]) ?? [];
  for (const r of rev) reviewByEngagement[r.engagement_id] = r;
}

const tutorById = await getTutorsByIds(sb, engagements.map((e) => e.tutor_id));
const STATUS: Record<EngagementRow["status"], { label: string; cls: string }> = {
  requested: { label: "Requested", cls: "bg-amber-100 text-amber-800" },
  contact_exchanged: { label: "Contact exchanged", cls: "bg-sky-100 text-sky-800" },
  started: { label: "In progress", cls: "bg-emerald-100 text-emerald-800" },
  completed: { label: "Completed", cls: "bg-slate-200 text-slate-700" },
  cancelled: { label: "Cancelled", cls: "bg-red-100 text-red-700" },
};
const input =
  "rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-800";
---

<Base
  title="My tutoring requests — TutorFinder BD"
  description="Your tutoring requests and reviews on TutorFinder BD."
  profile={profile}
>
  <section class="container-page py-10">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-slate-900">My tutoring requests</h1>
      <a href="/search/" class="text-sm font-medium text-emerald-700 hover:underline">+ Find more tutors</a>
    </div>

    {hasSupabase && engagements.length === 0 && (
      <div class="mt-8 rounded-2xl border border-dashed border-slate-300 p-10 text-center text-sm text-slate-500">
        You haven't sent any tutoring requests yet.{" "}
        <a href="/search/" class="text-emerald-700 hover:underline">Search for a tutor</a> and send your first request.
      </div>
    )}

    <div class="mt-6 space-y-4">
      {engagements.map((e) => {
        const tutor = tutorById[e.tutor_id];
        const review = reviewByEngagement[e.id];
        const st = STATUS[e.status] ?? STATUS.requested;
        return (
          <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <a href={tutor ? `/tutor/${tutor.slug}/` : "#"} class="font-semibold text-slate-900 hover:text-emerald-800">
                  {tutor ? tutor.name : e.tutor_id.slice(0, 8)}
                </a>
                <span class={`ml-2 rounded-full px-2 py-0.5 text-xs font-medium ${st.cls}`}>{st.label}</span>
              </div>
              <span class="text-xs text-slate-400">Sent {formatDate(e.created_at)}</span>
            </div>
            <div class="mt-3 grid gap-x-6 gap-y-1 text-sm text-slate-600 sm:grid-cols-2">
              {e.subject_note && <span><strong class="text-slate-700">Subject:</strong> {e.subject_note}</span>}
              {e.level_note && <span><strong class="text-slate-700">Class:</strong> {e.level_note}</span>}
              {e.guardian_notes && <span class="sm:col-span-2"><strong class="text-slate-700">Your note:</strong> {e.guardian_notes}</span>}
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-3">
              {e.status === "requested" && (
                <form method="post" action="/api/guardian/cancel/">
                  <input type="hidden" name="engagementId" value={e.id} />
                  <button class="rounded-lg border border-red-200 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50">
                    Cancel request
                  </button>
                </form>
              )}
              {e.status === "completed" && !review && (
                <details class="w-full rounded-xl border border-emerald-200 bg-emerald-50 p-4">
                  <summary class="cursor-pointer text-sm font-semibold text-emerald-800">
                    Leave a review for this tutor ✍️
                  </summary>
                  <form method="post" action="/api/reviews/create/" class="mt-4 grid gap-3 sm:grid-cols-2">
                    <input type="hidden" name="engagementId" value={e.id} />
                    {[
                      ["rating_overall", "Overall"],
                      ["rating_teaching", "Teaching skill"],
                      ["rating_punctuality", "Punctuality"],
                      ["rating_communication", "Communication"],
                    ].map(([name, label]) => (
                      <label class="flex items-center justify-between gap-2 text-xs font-medium text-slate-700">
                        {label}
                        <select name={name} required class={input}>
                          {[1, 2, 3, 4, 5].map((v) => <option value={v}>{v}</option>)}
                        </select>
                      </label>
                    ))}
                    <textarea name="comment" rows={3} placeholder="What did you like? (optional)" class={`${input} sm:col-span-2`}></textarea>
                    <button type="submit" class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800 sm:col-span-2">
                      Submit review
                    </button>
                  </form>
                </details>
              )}
              {review && (
                <span class="rounded-lg bg-emerald-50 px-3 py-1.5 text-xs font-medium text-emerald-800">
                  ★ {review.rating_overall}/5 — review {review.moderation_status === "approved" ? "live" : "under review"}
                </span>
              )}
              {e.status !== "cancelled" && e.status === "started" && (
                <form method="post" action="/api/tutor/engagement-status/">
                  <input type="hidden" name="engagementId" value={e.id} />
                  <input type="hidden" name="status" value="completed" />
                  <button class="rounded-lg bg-slate-800 px-3 py-1.5 text-xs font-medium text-white hover:bg-slate-900">
                    Mark completed
                  </button>
                </form>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Base>