---
interface Props {
  rating: number;
  size?: "sm" | "lg";
}
const { rating } = Astro.props;
const size = Astro.props.size ?? "sm";
const r = Math.round(rating * 2) / 2;
const full = Math.floor(r);
const half = r % 1 !== 0;
---

<!-- svelte-like rendering loop in Astro template -->
<span class="inline-flex items-center gap-0.5 text-amber-500" role="img" aria-label={`${rating} out of 5 stars`}>
  {Array.from({ length: 5 }, (_, i) => {
    if (i < full) {
      return <span class={size === "lg" ? "text-xl" : "text-sm"}>★</span>;
    } else if (i === full && half) {
      return <span class={size === "lg" ? "text-xl" : "text-sm"}>⯨</span>;
    } else {
      return <span class={size === "lg" ? "text-xl" : "text-sm"} style="opacity:.3">★</span>;
    }
  })}
</span>