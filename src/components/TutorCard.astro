---
import type { TutorWithRelations } from "../lib/db";
import { expLabel, formatFee, initials, modeLabels, photoUrl } from "../lib/directory";
import Stars from "./Stars.astro";

interface Props {
  tutor: TutorWithRelations;
}
const { tutor } = Astro.props;
const photo = photoUrl(tutor.photo_url);
const modes = modeLabels(tutor.modes);
---

<a
  href={`/tutor/${tutor.slug}/`}
  class="group rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-300 hover:shadow-md"
>
  <div class="flex items-start gap-3">
    {photo ? (
      <img src={photo} alt={tutor.name} class="h-14 w-14 rounded-xl object-cover" loading="lazy" />
    ) : (
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-lg font-bold text-emerald-800">
        {initials(tutor.name)}
      </span>
    )}
    <div class="min-w-0 flex-1">
      <div class="flex items-center gap-1.5">
        <span class="truncate font-semibold text-slate-900 group-hover:text-emerald-800">{tutor.name}</span>
        {tutor.verification_status === "verified" && (
          <span title="Verified tutor" class="text-emerald-600">✔</span>
        )}
      </div>
      <p class="truncate text-sm text-slate-600">{tutor.headline}</p>
      <p class="truncate text-xs text-slate-400">{tutor.institution}</p>
    </div>
    <div class="shrink-0 text-right">
      <div class="flex items-center justify-end gap-1">
        <Stars rating={tutor.ratings_avg} />
        <span class="text-xs font-medium text-slate-500">{tutor.ratings_avg > 0 ? tutor.ratings_avg.toFixed(1) : "New"}</span>
      </div>
      <p class="mt-1 text-sm font-semibold text-emerald-800">{formatFee(tutor.fee_min, tutor.fee_max, tutor.currency)}</p>
    </div>
  </div>

  {(tutor.subjects.length > 0 || modes.length > 0) && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tutor.subjects.slice(0, 3).map((s) => (
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{s.name}</span>
      ))}
      {tutor.subjects.length > 3 && (
        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-500">+{tutor.subjects.length - 3}</span>
      )}
      {modes.map((m) => (
        <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">{m}</span>
      ))}
    </div>
  )}
  <div class="mt-2 flex items-center gap-2 text-xs text-slate-400">
    <span>{expLabel(tutor.experience_months)} experience</span>
    {tutor.areas.length > 0 && (
      <span class="truncate">· {tutor.areas.slice(0, 2).map((a) => a.name).join(", ")}</span>
    )}
  </div>
</a>