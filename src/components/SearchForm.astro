---
import type { Area, Level, Subject } from "../lib/db";

interface Props {
  areas: Area[];
  subjects: Subject[];
  levels: Level[];
  values?: {
    q?: string;
    area?: string;
    subject?: string;
    level?: string;
    mode?: string;
    minRating?: string;
  };
  compact?: boolean;
}
const { areas, subjects, levels } = Astro.props;
const values = Astro.props.values ?? {};
const compact = Astro.props.compact ?? false;
const selectCls =
  "rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-800 focus:border-emerald-500 focus:outline-none";
const grid = compact
  ? "grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"
  : "grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4";
---

<form method="get" action="/search/" class={compact ? "" : "space-y-3"}>
  <div class={grid}>
    <input
      type="text"
      name="q"
      value={values.q ?? ""}
      placeholder="Search subject, class, tutor…"
      class={selectCls + " col-span-2 sm:col-span-2 lg:col-span-1"}
      aria-label="Search"
    />
    <select name="area" class={selectCls} aria-label="Area">
      <option value="">All areas</option>
      {areas.map((a) => (
        <option value={a.slug} selected={values.area === a.slug}>{a.name}</option>
      ))}
    </select>
    <select name="subject" class={selectCls} aria-label="Subject">
      <option value="">All subjects</option>
      {subjects.map((s) => (
        <option value={s.slug} selected={values.subject === s.slug}>{s.name}</option>
      ))}
    </select>
    <select name="level" class={selectCls} aria-label="Class / level">
      <option value="">All classes</option>
      {levels.map((l) => (
        <option value={l.code} selected={values.level === l.code}>{l.label}</option>
      ))}
    </select>
    <div class={compact ? "" : "flex gap-3"}>
      <select name="mode" class={selectCls + " flex-1"} aria-label="Teaching mode">
        <option value="">Any mode</option>
        <option value="home" selected={values.mode === "home"}>Home</option>
        <option value="online" selected={values.mode === "online"}>Online</option>
        <option value="group" selected={values.mode === "group"}>Group</option>
      </select>
      <select name="minRating" class={selectCls + " flex-1"} aria-label="Minimum rating">
        <option value="">Any rating</option>
        {[4, 4.5, 4.8].map((v) => (
          <option value={v} selected={values.minRating === String(v)}>{v}★+</option>
        ))}
      </select>
    </div>
  </div>
  <button
    type="submit"
    class="rounded-lg bg-emerald-700 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-800"
  >
    Find tutors
  </button>
</form>