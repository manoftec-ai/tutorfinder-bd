---
import type { Profile } from "../lib/db";

interface Props {
  profile?: Profile | null;
}
const { profile } = Astro.props;
const dashboard =
  profile?.role === "tutor"
    ? "/tutor/dashboard/"
    : profile?.role === "admin"
      ? "/admin/dashboard/"
      : "/guardian/dashboard/";
const nav = [
  { href: "/search/", label: "Find tutors" },
  { href: "/areas/", label: "Areas" },
  { href: "/subjects/", label: "Subjects" },
];
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-bold text-emerald-800">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-700 text-white">TF</span>
      <span>TutorFinder BD</span>
    </a>
    <nav class="hidden items-center gap-5 text-sm font-medium text-slate-600 sm:flex">
      {nav.map((item) => (
        <a href={item.href} class="hover:text-emerald-700">{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      {profile ? (
        <>
          <a
            href={dashboard}
            class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800"
          >
            Dashboard
          </a>
          <form method="post" action="/api/auth/logout/">
            <button type="submit" class="rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-600 hover:border-emerald-300">
              Logout
            </button>
          </form>
        </>
      ) : (
        <>
          <a href="/login/" class="px-2 py-2 text-sm font-medium text-slate-600 hover:text-emerald-700">
            Login
          </a>
          <a
            href="/join/"
            class="rounded-lg bg-emerald-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-800"
          >
            Join free
          </a>
        </>
      )}
    </div>
  </div>
  <nav class="container-page flex gap-4 border-t border-slate-100 py-2 text-xs font-medium text-slate-500 sm:hidden">
    {nav.map((item) => (
      <a href={item.href} class="hover:text-emerald-700">{item.label}</a>
    ))}
  </nav>
</header>